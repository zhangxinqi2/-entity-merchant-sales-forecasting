data/processed/
*.xlsx
*.xls
*.xlsm
*.docx
*.doc
*.pptx
*.ppt
*.pdf
*.sqlite
*.db
*.sql
!.env.example
!.config.ini.example
!data/sample/*.csv
!forecasting/config.ini.example
!forecasting/.env.example

# ---------------------------------------------------------------------------
